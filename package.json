{
  "name": "buy-cheap",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{css,html,json}": [
      "prettier --write"
    ],
    "e2e-tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "scripts": {
    "dev": "node build.cjs --browser=firefox",
    "build": "NODE_ENV=production node build.cjs",
    "build:firefox": "NODE_ENV=production node build.cjs --browser=firefox",
    "build:chrome": "NODE_ENV=production node build.cjs --browser=chrome",
    "watch:firefox": "node build.cjs --watch --browser=firefox",
    "watch:chrome": "node build.cjs --watch --browser=chrome",
    "clean": "rimraf build",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\"",
    "test:e2e": "playwright test --config e2e-tests/playwright.config.ts",
    "test:e2e:headed": "HEADED=1 playwright test --config e2e-tests/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config e2e-tests/playwright.config.ts --debug",
    "test:e2e:ui": "playwright test --config e2e-tests/playwright.config.ts --ui",
    "pretest:e2e": "npm run build:chrome",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QUENTlN/savvy-extension.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/QUENTlN/savvy-extension/issues"
  },
  "homepage": "https://github.com/QUENTlN/savvy-extension#readme",
  "description": "",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.4",
    "fs-extra": "^11.3.0",
    "postcss": "^8.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^25.2.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.4.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.22.0"
  }
}
